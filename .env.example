# hone-quant runtime configuration
#
# Production: /etc/hone-quant/runtime.env (root:hone-quant, mode 0640).
# Local development: copy to .env in the directory you start `hone-quant` from.
#
# Only deployment facts live here. Everything you tune while the app runs — plan times, costs,
# risk alerts, notification channels, strategy — is edited in the web UI and stored in PostgreSQL.

# --- Network -----------------------------------------------------------------------------------
# Listen on loopback only and reach the UI through an SSH/IAP tunnel or a reverse proxy.
HONE_QUANT_BIND=127.0.0.1:8090
# Public origin when served through a reverse proxy over HTTPS (enables strict cookies/links).
# HONE_QUANT_PUBLIC_URL=https://quant.example.com
# Cookie "Secure" flag: auto (default; follows HTTPS / X-Forwarded-Proto), true, or false.
# HONE_QUANT_SECURE_COOKIE=auto
# Serve under a path of a shared host, e.g. /quant for https://hone-claw.com/quant. The web UI
# must be built for the same path (HONE_QUANT_BASE_PATH=/quant scripts/build-release.sh): the
# server refuses to start otherwise. /api/health also answers at the root for local checks.
# HONE_QUANT_BASE_PATH=/quant
# Secret shared with the proxy in front (at least 32 printable characters: openssl rand -hex 32).
# Requests without a matching X-Hone-Quant-Origin-Token header get 404 (health checks excepted).
# HONE_QUANT_ORIGIN_TOKEN=

# --- PostgreSQL --------------------------------------------------------------------------------
# Resolution order: HONE_QUANT_DATABASE_URL → HONE_QUANT_PG_* → honeclaw's DATABASE_URL →
# honeclaw's HONE_POSTGRES_*. Everything lives in its own schema (default hone_quant), so the
# instance — or even honeclaw's database — can be shared safely. See deploy/postgres/setup.sql.
HONE_QUANT_DATABASE_URL=postgres://hone_quant:CHANGE_ME@127.0.0.1:5432/hone_quant
# HONE_QUANT_PG_HOST=127.0.0.1
# HONE_QUANT_PG_PORT=5432
# HONE_QUANT_PG_USER=hone_quant
# HONE_QUANT_PG_PASSWORD=CHANGE_ME
# HONE_QUANT_PG_DATABASE=hone_quant
# HONE_QUANT_DB_SCHEMA=hone_quant
# HONE_QUANT_DB_POOL_SIZE=8

# --- Market data -------------------------------------------------------------------------------
# fmp (real data, requires a key) or demo (synthetic prices for trying the app).
HONE_QUANT_MARKET_DATA=fmp
# Your Financial Modeling Prep key(s); several keys (comma-separated) are rotated on rate limits.
HONE_QUANT_FMP_API_KEY=
# HONE_QUANT_FMP_API_KEYS=key1,key2
# …or reuse the fmp: block of honeclaw's config.yaml (config.overrides.yaml wins):
# HONE_QUANT_HONECLAW_CONFIG=/opt/hone/current/config.yaml
# HONE_QUANT_FMP_API=auto           # auto | stable | legacy
# HONE_QUANT_FMP_RPM=240            # requests per minute across all keys
# HONE_QUANT_FMP_TIMEOUT_SECS=20
# HONE_QUANT_HISTORY_YEARS=10       # daily history kept for strategy, charts and backtests

# --- Security ----------------------------------------------------------------------------------
# State directory: holds secret.key (seals notification-channel credentials; created on first
# start with mode 0600). Back it up together with the database.
HONE_QUANT_STATE_DIR=/var/lib/hone-quant
# Alternatively provide the key directly (base64 of 32 random bytes): openssl rand -base64 32
# HONE_QUANT_SECRET_KEY=
# First administrator, created on first start only when no user exists yet. Remove the password
# from this file after the first sign-in (or create users with `hone-quant user add`).
# HONE_QUANT_ADMIN_USER=admin
# HONE_QUANT_ADMIN_PASSWORD=
# Sign-in: local (default, hone-quant's own users) or honeclaw: no local accounts at all; only
# administrators signed in to honeclaw get in. The browser's honeclaw session cookie is checked
# on the server against honeclaw's /api/public/auth/me (user.is_admin must be true); anything
# that cannot be verified is refused. Serve hone-quant on honeclaw's site (e.g. /quant) so the
# browser sends that cookie. See docs/deploy-hone-claw-quant.md.
# HONE_QUANT_AUTH_MODE=honeclaw
# HONE_QUANT_HONECLAW_AUTH_URL=https://hone-claw.com/api/public/auth/me   # https (http on loopback only)
# HONE_QUANT_HONECLAW_SESSION_COOKIE=hone_web_session
# HONE_QUANT_HONECLAW_LOGIN_URL=https://hone-claw.com/
# HONE_QUANT_HONECLAW_CACHE_SECS=30   # how long an admission is cached (at most 300)

# --- Paper account & calendar --------------------------------------------------------------------
# Starting cash of the paper account (used when the account is first created).
# HONE_QUANT_INITIAL_CASH=1000000
# Unscheduled exchange closures the rule-based NYSE calendar cannot know (YYYY-MM-DD,...).
# HONE_QUANT_EXTRA_CLOSURES=

# --- Operations ----------------------------------------------------------------------------------
# HONE_QUANT_SCHEDULER=true         # set false on a second, read-only instance
# HONE_QUANT_LOG=info               # tracing filter, e.g. info,quant_server=debug
# HONE_QUANT_LOG_FORMAT=json        # json | text
# HONE_QUANT_UNIVERSE_PATH=         # override the bundled universe (honeclaw ontology export)
