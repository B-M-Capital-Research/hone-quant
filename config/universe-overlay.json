{
  "_comment": "Bilingual display names and portfolio-construction choices layered on top of the honeclaw industry ontology (skills/industry-map/references/industry-map.json). Membership always comes from the ontology; this file only names things and picks a primary sector for companies listed in more than one sector.",
  "sectors": {
    "ai-chip": {
      "name_zh": "AI 芯片",
      "name_en": "AI Chips",
      "summary_en": "Task growth reaches revenue and per-share value only through unit efficiency, deliverable systems and vendor value capture."
    },
    "storage": {
      "name_zh": "存储",
      "name_en": "Memory & Storage",
      "summary_en": "AI memory demand, qualified supply and contract delivery decide profit durability; HBM, commodity DRAM, NAND and HDD are modelled separately."
    },
    "optical": {
      "name_zh": "光通信与 AI 互连",
      "name_en": "Optical & AI Interconnect",
      "summary_en": "Interconnect value comes from reducing system wait time, but revenue counts only qualified components, modules or systems sold externally."
    },
    "power": {
      "name_zh": "电力与供电",
      "name_en": "Power & Energy Supply",
      "summary_en": "Power value depends on delivery timing, reliability and lifetime cost; equipment revenue and power-sales cash flows are never mixed."
    },
    "neocloud": {
      "name_zh": "新云",
      "name_en": "Neoclouds",
      "summary_en": "Contracts create durable equity value only once they become billable capacity and post-financing cash returns per share."
    },
    "equipment": {
      "name_zh": "半导体设备",
      "name_en": "Semiconductor Equipment",
      "summary_en": "Process complexity becomes equipment revenue only through customer investment, orders and acceptance."
    },
    "server-oem": {
      "name_zh": "AI 服务器与整机",
      "name_en": "AI Servers & Systems",
      "summary_en": "Server valuation rests on retained profit and capital turnover; pass-through GPU content earns no chip-platform premium."
    },
    "hyperscaler": {
      "name_zh": "云厂与 AI 平台",
      "name_en": "Hyperscalers & AI Platforms",
      "summary_en": "Cloud platform value comes from paid adoption and incremental returns on capital; RPO and capex size are not value in themselves."
    },
    "space": {
      "name_zh": "商业太空",
      "name_en": "Commercial Space",
      "summary_en": "Launch, satellite systems and connectivity services run different capital cycles; value is assessed per deliverable contract and service economics."
    },
    "ai-apps": {
      "name_zh": "AI 应用与数据服务",
      "name_en": "AI Applications & Data Services",
      "summary_en": "AI adoption must turn into billing, retention and unit economics; different revenue models cannot share one software multiple."
    }
  },
